/-
  Singularity.Certificates  (roadmap push P33)

  Kernel check of the two decisive coefficient certificates
  (`results/certificates/spectral.json`, `results/certificates/binary_census.json`,
  format `singularity.certificate/1`) against the semantic coefficient
  `allCount` of P07 (`Singularity/Normalization.lean`).

  Chain of evidence:
  1. `comps n V` enumerates the length-`n` profiles of volume exactly `V`
     (`mem_comps`, `comps_nodup`).
  2. `allCount_eq_compCount`: the P07 coefficient, defined by filtering the
     box `box n V`, equals the count obtained by filtering `comps n V` by energy.
  3. `look_hist`: the histogram accumulator `hist E n V` returns that count for
     every energy.  Hence `allCount E n V e = look e (hist E n V)` for all `e : Int`.
  4. `agree` compares a histogram with a transcribed table in both directions;
     `table_of_ok` turns a successful comparison (evaluated by `decide` in the
     kernel) into `∀ e, allCount E n V e = look e row`.
  5. Comparison of two graphs, the first-difference polynomial and the
     expansion of its stated factorization are derived from the tables.

  The tables are literals in `Singularity/CertificateData.lean`, generated by
  `formal/tools/gen_certificates.py`.  That transcription is the only trusted link.

  No `sorry`, `admit`, `axiom`, `native_decide`, `implemented_by` or `unsafe` is used.
-/
import Singularity.Normalization
import Singularity.Thresholds
import Singularity.CertificateData

namespace Singularity

/-! ## Weak compositions: profiles of exact volume -/

/-- All lists of length `n` of natural numbers with sum exactly `V`. -/
def comps : Nat → Nat → List (List Nat)
  | 0, 0 => [[]]
  | 0, _ + 1 => []
  | n + 1, V => (List.range (V + 1)).bind (fun x => (comps n (V - x)).map (x :: ·))

theorem mem_comps : ∀ (n V : Nat) (a : List Nat), a ∈ comps n V ↔ a.length = n ∧ vol a = V
  | 0, 0, a => by cases a <;> simp [comps, vol]
  | 0, V + 1, a => by cases a <;> simp [comps, vol]
  | n + 1, V, a => by
      cases a with
      | nil => simp [comps]
      | cons y ys =>
          simp only [comps, List.mem_bind, List.mem_range, List.mem_map, List.length_cons, vol]
          constructor
          · rintro ⟨x, hx, c, hc, he⟩
            injection he with h1 h2
            subst h1; subst h2
            have := (mem_comps n (V - x) c).mp hc
            exact ⟨by omega, by omega⟩
          · rintro ⟨hl, hv⟩
            exact ⟨y, by omega, ys, (mem_comps n (V - y) ys).mpr ⟨by omega, by omega⟩, rfl⟩

private theorem nodup_bind_cons_dep (f : Nat → List (List Nat)) (hf : ∀ x, (f x).Nodup) :
    ∀ (l : List Nat), l.Nodup → (l.bind (fun x => (f x).map (x :: ·))).Nodup
  | [], _ => List.Pairwise.nil
  | x :: xs, hl => by
      rw [List.bind_cons]
      have hl' := List.nodup_cons.mp hl
      unfold List.Nodup
      rw [List.pairwise_append]
      refine ⟨?_, nodup_bind_cons_dep f hf xs hl'.2, ?_⟩
      · exact List.Pairwise.map _ (fun a b h e => h (List.cons.inj e).2) (hf x)
      · intro p hp q hq e
        rcases List.mem_map.mp hp with ⟨c, _, rfl⟩
        rcases List.mem_bind.mp hq with ⟨y, hy, hq'⟩
        rcases List.mem_map.mp hq' with ⟨d, _, rfl⟩
        have : x = y := (List.cons.inj e).1
        subst this
        exact hl'.1 hy

theorem comps_nodup : ∀ (n V : Nat), (comps n V).Nodup
  | 0, 0 => by simp [comps]
  | 0, _ + 1 => by simp [comps]
  | n + 1, _ => nodup_bind_cons_dep _ (fun x => comps_nodup n _) _ (List.nodup_range _)

/-! ## Bridge to the semantic coefficient of P07 -/

/-- Profiles of exact volume `V` and energy `e`, read off the composition list. -/
def compFilter (E : List (Nat × Nat)) (n V : Nat) (e : Int) : List (List Nat) :=
  (comps n V).filter (fun a => decide (energy E a = e))

/-- The P07 coefficient `[x^V q^e] L_G` (defined through `box n V`) equals the
    count over weak compositions. -/
theorem allCount_eq_compCount (E : List (Nat × Nat)) (n V : Nat) (e : Int) :
    allCount E n V e = (compFilter E n V e).length := by
  unfold allCount
  apply length_eq_of_nodup_mem_iff
  · exact List.Pairwise.filter _ (box_nodup n V)
  · exact List.Pairwise.filter _ (comps_nodup n V)
  · intro a
    rw [mem_allFilter]
    unfold compFilter
    rw [List.mem_filter, mem_comps]
    simp only [decide_eq_true_eq]
    constructor
    · rintro ⟨hl, hv, he⟩; exact ⟨⟨hl, hv⟩, he⟩
    · rintro ⟨⟨hl, hv⟩, he⟩; exact ⟨hl, hv, he⟩

/-! ## Histogram accumulator -/

/-- Add one occurrence of energy `x` to a histogram. -/
def addE (x : Int) : List (Int × Nat) → List (Int × Nat)
  | [] => [(x, 1)]
  | p :: r => if p.1 = x then (p.1, p.2 + 1) :: r else p :: addE x r

/-- Histogram of a list of energies. -/
def histOf : List Int → List (Int × Nat)
  | [] => []
  | x :: xs => addE x (histOf xs)

/-- Value recorded for energy `e` (first matching entry; `0` if absent). -/
def look (e : Int) : List (Int × Nat) → Nat
  | [] => 0
  | p :: r => if p.1 = e then p.2 else look e r

theorem look_addE (e x : Int) : ∀ (h : List (Int × Nat)),
    look e (addE x h) = look e h + (if x = e then 1 else 0)
  | [] => by by_cases hx : x = e <;> simp [addE, look, hx]
  | p :: r => by
      have ih := look_addE e x r
      by_cases h1 : p.1 = x <;> by_cases h2 : p.1 = e <;> by_cases h3 : x = e <;>
        simp_all [addE, look] <;> omega

theorem look_histOf (e : Int) : ∀ (l : List Int),
    look e (histOf l) = (l.filter (fun x => decide (x = e))).length
  | [] => rfl
  | x :: xs => by
      simp only [histOf, look_addE, look_histOf e xs, List.filter_cons]
      by_cases hx : x = e <;> simp [hx]

/-- The energy histogram of all profiles of volume `V`. -/
def hist (E : List (Nat × Nat)) (n V : Nat) : List (Int × Nat) :=
  histOf ((comps n V).map (energy E))

/-- **Histogram correctness.**  For every energy `e`, the computed histogram
    returns the semantic coefficient `[x^V q^e] L_G`. -/
theorem allCount_eq_look_hist (E : List (Nat × Nat)) (n V : Nat) (e : Int) :
    allCount E n V e = look e (hist E n V) := by
  rw [allCount_eq_compCount, hist, look_histOf, List.filter_map, List.length_map]
  rfl

/-! ## Comparing a histogram with a transcribed table -/

theorem look_cases (e : Int) : ∀ (H : List (Int × Nat)), look e H = 0 ∨ (e, look e H) ∈ H
  | [] => Or.inl rfl
  | p :: r => by
      unfold look
      by_cases h : p.1 = e
      · rw [if_pos h]; right; rw [← h]; exact List.mem_cons_self _ _
      · rw [if_neg h]
        rcases look_cases e r with h' | h'
        · exact Or.inl h'
        · exact Or.inr (List.mem_cons_of_mem _ h')

theorem look_eq_zero (e : Int) : ∀ (H : List (Int × Nat)), e ∉ H.map (·.1) → look e H = 0
  | [] => fun _ => rfl
  | p :: r => by
      intro h
      simp only [List.map, List.mem_cons, not_or] at h
      unfold look
      rw [if_neg (fun h' => h.1 h'.symm)]
      exact look_eq_zero e r h.2

/-- Two-sided agreement of a histogram `H` and a table `T`. -/
def agree (H T : List (Int × Nat)) : Bool :=
  H.all (fun p => decide (look p.1 T = p.2)) && T.all (fun p => decide (look p.1 H = p.2))

theorem agree_left {H T : List (Int × Nat)} (h : agree H T = true) :
    ∀ p ∈ H, look p.1 T = p.2 := by
  unfold agree at h
  rw [Bool.and_eq_true, List.all_eq_true, List.all_eq_true] at h
  intro p hp; exact of_decide_eq_true (h.1 p hp)

theorem agree_right {H T : List (Int × Nat)} (h : agree H T = true) :
    ∀ p ∈ T, look p.1 H = p.2 := by
  unfold agree at h
  rw [Bool.and_eq_true, List.all_eq_true, List.all_eq_true] at h
  intro p hp; exact of_decide_eq_true (h.2 p hp)

theorem look_eq_of_agree {H T : List (Int × Nat)} (h : agree H T = true) (e : Int) :
    look e H = look e T := by
  rcases look_cases e H with h1 | h1
  · rcases look_cases e T with h2 | h2
    · rw [h1, h2]
    · exact agree_right h _ h2
  · exact (agree_left h _ h1).symm

/-- Volume-by-volume agreement of the computed histograms with a table. -/
def tableOK (E : List (Nat × Nat)) (n : Nat) (T : List (List (Int × Nat))) : Bool :=
  (List.range T.length).all (fun V => agree (hist E n V) (T.getD V []))

theorem rowOK_of_tableOK {E : List (Nat × Nat)} {n : Nat} {T : List (List (Int × Nat))}
    (h : tableOK E n T = true) (V : Nat) (hV : V < T.length) :
    agree (hist E n V) (T.getD V []) = true := by
  unfold tableOK at h
  rw [List.all_eq_true] at h
  exact h V (List.mem_range.mpr hV)

/-- **Table theorem.**  If the kernel evaluates `tableOK E n T` to `true`, then for
    every listed volume `V` and every energy `e : Int`, the semantic coefficient
    `[x^V q^e] L_G` is the table value (`0` for energies not listed). -/
theorem table_of_ok {E : List (Nat × Nat)} {n : Nat} {T : List (List (Int × Nat))}
    (h : tableOK E n T = true) (V : Nat) (hV : V < T.length) (e : Int) :
    allCount E n V e = look e (T.getD V []) := by
  rw [allCount_eq_look_hist]
  exact look_eq_of_agree (rowOK_of_tableOK h V hV) e

/-- Entry form: every listed `(energy, count)` is a true coefficient. -/
theorem table_entries_of_ok {E : List (Nat × Nat)} {n : Nat} {T : List (List (Int × Nat))}
    (h : tableOK E n T = true) (V : Nat) (hV : V < T.length) :
    ∀ p ∈ T.getD V [], allCount E n V p.1 = p.2 := by
  intro p hp
  rw [allCount_eq_look_hist]
  exact agree_right (rowOK_of_tableOK h V hV) p hp

/-- Completeness form: energies absent from a row have coefficient `0`. -/
theorem table_absent_of_ok {E : List (Nat × Nat)} {n : Nat} {T : List (List (Int × Nat))}
    (h : tableOK E n T = true) (V : Nat) (hV : V < T.length) (e : Int)
    (he : e ∉ (T.getD V []).map (·.1)) : allCount E n V e = 0 := by
  rw [table_of_ok h V hV e]; exact look_eq_zero e _ he

/-! ## Integer coefficient checks over finitely many keys -/

/-- Integer-valued sparse lookup. -/
def plook (e : Int) : List (Int × Int) → Int
  | [] => 0
  | p :: r => if p.1 = e then p.2 else plook e r

theorem plook_eq_zero (e : Int) : ∀ (P : List (Int × Int)), e ∉ P.map (·.1) → plook e P = 0
  | [] => fun _ => rfl
  | p :: r => by
      intro h
      simp only [List.map, List.mem_cons, not_or] at h
      unfold plook
      rw [if_neg (fun h' => h.1 h'.symm)]
      exact plook_eq_zero e r h.2

/-- If two integer functions agree on `keys` and both vanish off `keys`, they are equal. -/
theorem fun_eq_of_keys (f g : Int → Int) (keys : List Int)
    (hk : keys.all (fun k => decide (f k = g k)) = true)
    (hf : ∀ e, e ∉ keys → f e = 0) (hg : ∀ e, e ∉ keys → g e = 0) (e : Int) : f e = g e := by
  rw [List.all_eq_true] at hk
  by_cases he : e ∈ keys
  · exact of_decide_eq_true (hk e he)
  · rw [hf e he, hg e he]

/-- Signed difference of two coefficient rows. -/
def diffAt (R1 R2 : List (Int × Nat)) (e : Int) : Int := (look e R1 : Int) - look e R2

def rowKeys (R1 R2 : List (Int × Nat)) : List Int := R1.map (·.1) ++ R2.map (·.1)

theorem diffAt_off (R1 R2 : List (Int × Nat)) (keys : List Int) (e : Int)
    (hsub : ∀ k ∈ rowKeys R1 R2, k ∈ keys) (he : e ∉ keys) : diffAt R1 R2 e = 0 := by
  unfold diffAt
  have h1 : e ∉ R1.map (·.1) := fun h => he (hsub e (List.mem_append_left _ h))
  have h2 : e ∉ R2.map (·.1) := fun h => he (hsub e (List.mem_append_right _ h))
  rw [look_eq_zero e R1 h1, look_eq_zero e R2 h2]; rfl

/-- Check that the difference of two rows is the sparse polynomial `P`. -/
def diffOK (R1 R2 : List (Int × Nat)) (P : List (Int × Int)) : Bool :=
  (rowKeys R1 R2 ++ P.map (·.1)).all (fun k => decide (diffAt R1 R2 k = plook k P))

theorem diff_of_ok {R1 R2 : List (Int × Nat)} {P : List (Int × Int)} (h : diffOK R1 R2 P = true)
    (e : Int) : diffAt R1 R2 e = plook e P :=
  fun_eq_of_keys (diffAt R1 R2) (fun k => plook k P) _ h
    (fun e he => diffAt_off R1 R2 _ e (fun _ hk => List.mem_append_left _ hk) he)
    (fun e he => plook_eq_zero e P (fun h' => he (List.mem_append_right _ h'))) e

/-! ## Dense integer polynomials and the factorization -/

/-- `p.getD i 0` is the coefficient of `q^i`. -/
def padd : List Int → List Int → List Int
  | [], q => q
  | p, [] => p
  | a :: p, b :: q => (a + b) :: padd p q

def pscale (c : Int) (p : List Int) : List Int := p.map (c * ·)

def pmul : List Int → List Int → List Int
  | [], _ => []
  | a :: p, q => padd (pscale a q) (0 :: pmul p q)

def ppow (p : List Int) : Nat → List Int
  | 0 => [1]
  | k + 1 => pmul p (ppow p k)

/-- `q^m`. -/
def pmono (m : Nat) : List Int := List.replicate m 0 ++ [1]

/-- `1 - q^k` (the zero polynomial for `k = 0`, which the data never uses). -/
def oneMinusQ : Nat → List Int
  | 0 => []
  | k + 1 => 1 :: (List.replicate k 0 ++ [-1])

/-- `c · q^m · ∏ (1 - q^k)^mult`, the `singularity.certificate/1` factorization. -/
def expandFac (c : Int) (m : Nat) (fs : List (Nat × Nat)) : List Int :=
  fs.foldl (fun acc f => pmul acc (ppow (oneMinusQ f.1) f.2)) (pscale c (pmono m))

/-- Coefficient of `q^e` in a dense polynomial (`0` for negative `e`). -/
def dcoeff (p : List Int) : Int → Int
  | Int.ofNat i => p.getD i 0
  | Int.negSucc _ => 0

theorem getD_zero_of_le : ∀ (p : List Int) (i : Nat), p.length ≤ i → p.getD i 0 = 0
  | [], _, _ => rfl
  | _ :: _, 0, h => by simp at h
  | _ :: p, i + 1, h => by
      simp only [List.getD_cons_succ]
      exact getD_zero_of_le p i (by simp at h; omega)

/-- Check that the row difference is the dense polynomial `p`. -/
def denseOK (R1 R2 : List (Int × Nat)) (p : List Int) : Bool :=
  (rowKeys R1 R2 ++ (List.range p.length).map Int.ofNat).all
    (fun k => decide (diffAt R1 R2 k = dcoeff p k))

theorem dense_of_ok {R1 R2 : List (Int × Nat)} {p : List Int} (h : denseOK R1 R2 p = true)
    (e : Int) : diffAt R1 R2 e = dcoeff p e :=
  fun_eq_of_keys (diffAt R1 R2) (dcoeff p) _ h
    (fun e he => diffAt_off R1 R2 _ e (fun _ hk => List.mem_append_left _ hk) he)
    (fun e he => by
      cases e with
      | ofNat i =>
          apply getD_zero_of_le
          apply Nat.le_of_not_lt
          intro hi
          exact he (List.mem_append_right _ (List.mem_map.mpr ⟨i, List.mem_range.mpr hi, rfl⟩))
      | negSucc _ => rfl) e

/-! ## Evaluation semantics of the dense polynomial operations

These lemmas show that `expandFac c m fs` really is the polynomial
`c · q^m · ∏ (1 - q^k)^mult`: its evaluation at every integer `x` is that product. -/

def peval : List Int → Int → Int
  | [], _ => 0
  | a :: p, x => a + x * peval p x

theorem peval_padd : ∀ (p q : List Int) (x : Int), peval (padd p q) x = peval p x + peval q x
  | [], q, x => by simp [padd, peval]
  | a :: p, [], x => by simp [padd, peval]
  | a :: p, b :: q, x => by
      simp only [padd, peval, peval_padd p q x, Int.mul_add]
      omega

theorem peval_pscale (c : Int) : ∀ (p : List Int) (x : Int), peval (pscale c p) x = c * peval p x
  | [], _ => by simp [pscale, peval]
  | a :: p, x => by
      have ih := peval_pscale c p x
      simp only [pscale, List.map] at ih ⊢
      simp only [peval, ih, Int.mul_add]
      rw [Int.mul_left_comm]

theorem peval_pmul : ∀ (p q : List Int) (x : Int), peval (pmul p q) x = peval p x * peval q x
  | [], q, x => by simp [pmul, peval]
  | a :: p, q, x => by
      simp only [pmul, peval_padd, peval_pscale, peval, peval_pmul p q x, Int.add_mul, Int.zero_add,
        Int.mul_assoc]

theorem peval_ppow (p : List Int) (x : Int) : ∀ k, peval (ppow p k) x = peval p x ^ k
  | 0 => by simp only [ppow, peval, Int.mul_zero, Int.add_zero]; rfl
  | k + 1 => by rw [ppow, peval_pmul, peval_ppow p x k, Int.pow_succ, Int.mul_comm]

theorem peval_replicate_append (x : Int) : ∀ (m : Nat) (tail : List Int),
    peval (List.replicate m 0 ++ tail) x = x ^ m * peval tail x
  | 0, tail => by
      show peval tail x = 1 * peval tail x
      rw [Int.one_mul]
  | m + 1, tail => by
      rw [List.replicate_succ, List.cons_append, peval, peval_replicate_append x m tail,
        Int.zero_add, Int.pow_succ, Int.mul_comm (x ^ m) x, Int.mul_assoc]

theorem peval_pmono (m : Nat) (x : Int) : peval (pmono m) x = x ^ m := by
  unfold pmono
  rw [peval_replicate_append]
  simp [peval]

theorem peval_oneMinusQ (x : Int) : ∀ k, 1 ≤ k → peval (oneMinusQ k) x = 1 - x ^ k
  | 0, h => absurd h (by decide)
  | k + 1, _ => by
      rw [oneMinusQ, peval, peval_replicate_append, peval, peval, Int.mul_zero, Int.add_zero,
        Int.mul_neg, Int.mul_one, Int.mul_neg, Int.pow_succ, Int.mul_comm x (x ^ k)]
      omega

/-- `∏ (1 - x^k)^mult` over a factor list. -/
def facProd (x : Int) : List (Nat × Nat) → Int
  | [] => 1
  | f :: fs => (1 - x ^ f.1) ^ f.2 * facProd x fs

theorem peval_foldl (x : Int) : ∀ (fs : List (Nat × Nat)) (acc : List Int),
    (∀ f ∈ fs, 1 ≤ f.1) →
    peval (fs.foldl (fun acc f => pmul acc (ppow (oneMinusQ f.1) f.2)) acc) x =
      peval acc x * facProd x fs
  | [], acc, _ => by simp [facProd]
  | f :: fs, acc, h => by
      simp only [List.foldl]
      rw [peval_foldl x fs _ (fun g hg => h g (List.mem_cons_of_mem _ hg)), peval_pmul,
        peval_ppow, peval_oneMinusQ x f.1 (h f (List.mem_cons_self _ _)), facProd, Int.mul_assoc]

/-- **Factorization semantics.**  For factors of positive degree, `expandFac c m fs`
    evaluates at every integer `x` to `c · x^m · ∏ (1 - x^k)^mult`. -/
theorem peval_expandFac (c : Int) (m : Nat) (fs : List (Nat × Nat)) (h : ∀ f ∈ fs, 1 ≤ f.1)
    (x : Int) : peval (expandFac c m fs) x = c * x ^ m * facProd x fs := by
  unfold expandFac
  rw [peval_foldl x fs _ h, peval_pscale, peval_pmono]

/-! ## Nested threshold description of the same counts (P08) -/

/-- Right side of P08's `energy_nested` with `M` levels. -/
def nestedE (E : List (Nat × Nat)) (a : List Nat) (M : Nat) : Int :=
  rsum M (fun r => cutSize E a r) + 2 * rsum M (fun s => rsum (s - 1) (fun r => crossCount E a r s))

/-- The coefficient `[x^V q^e] L_G` also counts the profiles of volume `V` whose
    nested threshold energy (levels `1..V`, cuts plus twice the crossings) is `e`. -/
theorem allCount_eq_nestedCount (E : List (Nat × Nat)) (n V : Nat) (e : Int) :
    allCount E n V e = ((comps n V).filter (fun a => decide (nestedE E a V = e))).length := by
  rw [allCount_eq_compCount]
  unfold compFilter
  congr 1
  apply List.filter_congr
  intro a ha
  have hv := ((mem_comps n V a).mp ha).2
  have hM : lmax a ≤ V := (lmax_le_iff a V).mpr (fun x hx => hv ▸ le_vol a x hx)
  rw [energy_nested E a V hM]
  rfl

/-! ## From table checks to pair statements -/

theorem below_of_tables {G1 G2 : List (Nat × Nat)} {n d : Nat} {T1 T2 : List (List (Int × Nat))}
    (h1 : tableOK G1 n T1 = true) (h2 : tableOK G2 n T2 = true)
    (hd1 : d ≤ T1.length) (hd2 : d ≤ T2.length)
    (hb : ∀ V, V < d → T1.getD V [] = T2.getD V []) :
    ∀ V, V < d → ∀ e, allCount G1 n V e = allCount G2 n V e := by
  intro V hV e
  rw [table_of_ok h1 V (by omega), table_of_ok h2 V (by omega), hb V hV]

theorem diffPoly_of_tables {G1 G2 : List (Nat × Nat)} {n d : Nat} {T1 T2 : List (List (Int × Nat))}
    {P : List (Int × Int)} (h1 : tableOK G1 n T1 = true) (h2 : tableOK G2 n T2 = true)
    (hd1 : d < T1.length) (hd2 : d < T2.length) (hp : diffOK (T1.getD d []) (T2.getD d []) P = true) :
    ∀ e, (allCount G1 n d e : Int) - allCount G2 n d e = plook e P := by
  intro e
  rw [table_of_ok h1 d hd1, table_of_ok h2 d hd2]
  exact diff_of_ok hp e

theorem dense_of_tables {G1 G2 : List (Nat × Nat)} {n d : Nat} {T1 T2 : List (List (Int × Nat))}
    {p : List Int} (h1 : tableOK G1 n T1 = true) (h2 : tableOK G2 n T2 = true)
    (hd1 : d < T1.length) (hd2 : d < T2.length) (hp : denseOK (T1.getD d []) (T2.getD d []) p = true) :
    ∀ e, (allCount G1 n d e : Int) - allCount G2 n d e = dcoeff p e := by
  intro e
  rw [table_of_ok h1 d hd1, table_of_ok h2 d hd2]
  exact dense_of_ok hp e

/-- P07 normalization for volumes below `n`: the minimum-zero table equals the local one. -/
theorem norm_of_tables {G : List (Nat × Nat)} {n : Nat} {T N : List (List (Int × Nat))}
    (h : tableOK G n T = true) (V : Nat) (hV : V < T.length) (hn : V < n)
    (hN : N.getD V [] = T.getD V []) (e : Int) : mzCount G n V e = look e (N.getD V []) := by
  rw [← allCount_eq_mzCount_of_lt G n V e hn, hN]
  exact table_of_ok h V hV e

/-! ## The two released certificates

Each `*_tableOK` and `*_diffOK`/`*_denseOK` fact is evaluated by `decide` in the kernel:
the kernel enumerates `comps 7 V` for `V ≤ 4` (330 profiles per graph), computes
every energy and the histogram, and compares it with the transcribed literal.
-/

namespace Cert

set_option maxRecDepth 100000

/-! ### Spectral pair (`results/certificates/spectral.json`) -/

theorem spectral_tableOK : tableOK spectralG spectralN spectralTable = true := by decide
theorem spectralCmp_tableOK : tableOK spectralCmpG spectralN spectralCmpTable = true := by decide

theorem spectral_len : spectralTable.length = spectralMaxVolume + 1 := rfl
theorem spectralCmp_len : spectralCmpTable.length = spectralMaxVolume + 1 := rfl

/-- Every coefficient `[x^V q^e] L_G`, `V ≤ max_volume`, `e : Int`, of the certificate
    graph is the transcribed `local_coefficients` value (`0` for unlisted energies). -/
theorem spectral_local : ∀ V, V ≤ spectralMaxVolume → ∀ e : Int,
    allCount spectralG spectralN V e = look e (spectralTable.getD V []) :=
  fun V hV => table_of_ok spectral_tableOK V (by rw [spectral_len]; omega)

/-- Entry form of `spectral_local`: each listed `(energy, count)` is a true coefficient. -/
theorem spectral_local_entries : ∀ V, V ≤ spectralMaxVolume → ∀ p ∈ spectralTable.getD V [],
    allCount spectralG spectralN V p.1 = p.2 :=
  fun V hV => table_entries_of_ok spectral_tableOK V (by rw [spectral_len]; omega)

/-- The same for the comparison graph. -/
theorem spectralCmp_local : ∀ V, V ≤ spectralMaxVolume → ∀ e : Int,
    allCount spectralCmpG spectralN V e = look e (spectralCmpTable.getD V []) :=
  fun V hV => table_of_ok spectralCmp_tableOK V (by rw [spectralCmp_len]; omega)

theorem spectralCmp_local_entries : ∀ V, V ≤ spectralMaxVolume → ∀ p ∈ spectralCmpTable.getD V [],
    allCount spectralCmpG spectralN V p.1 = p.2 :=
  fun V hV => table_entries_of_ok spectralCmp_tableOK V (by rw [spectralCmp_len]; omega)

/-- `normalized_coefficients` (`[x^V q^e] B_G`) follow from P07 (`allCount_eq_mzCount_of_lt`),
    since every listed volume is below `n = 7`. -/
theorem spectral_normalized : ∀ V, V ≤ spectralMaxVolume → ∀ e : Int,
    mzCount spectralG spectralN V e = look e (spectralNormTable.getD V []) := by
  intro V hV e
  have hrows : ∀ W, W < spectralMaxVolume + 1 → spectralNormTable.getD W [] = spectralTable.getD W [] := by decide
  exact norm_of_tables spectral_tableOK V (by rw [spectral_len]; omega)
    (by unfold spectralMaxVolume at hV; unfold spectralN; omega) (hrows V (by omega)) e

/-- P08 reading of the table: the transcribed values count profiles by nested threshold energy. -/
theorem spectral_nested : ∀ V, V ≤ spectralMaxVolume → ∀ e : Int,
    ((comps spectralN V).filter (fun a => decide (nestedE spectralG a V = e))).length = look e (spectralTable.getD V []) :=
  fun V hV e => (allCount_eq_nestedCount _ _ _ _).symm.trans (spectral_local V hV e)

/-- Equality of all coefficients at every volume below the first discrepancy. -/
theorem spectral_agree_below : ∀ V, V < spectralDiffVolume → ∀ e : Int,
    allCount spectralG spectralN V e = allCount spectralCmpG spectralN V e :=
  below_of_tables spectral_tableOK spectralCmp_tableOK (by decide) (by decide) (by decide)

/-- The first-difference polynomial `[x^d](L_G - L_G')` is the transcribed one. -/
theorem spectral_first_difference : ∀ e : Int,
    (allCount spectralG spectralN spectralDiffVolume e : Int) - allCount spectralCmpG spectralN spectralDiffVolume e =
      plook e spectralDiffPoly :=
  diffPoly_of_tables spectral_tableOK spectralCmp_tableOK (by decide) (by decide) (by decide)

/-- The first difference is the expansion of the stated factorization
    `c · q^m · ∏ (1 - q^k)^mult` (computed by `expandFac`). -/
theorem spectral_factorization : ∀ e : Int,
    (allCount spectralG spectralN spectralDiffVolume e : Int) - allCount spectralCmpG spectralN spectralDiffVolume e =
      dcoeff (expandFac spectralFacCoeff spectralFacMonomial spectralFacFactors) e :=
  dense_of_tables spectral_tableOK spectralCmp_tableOK (by decide) (by decide) (by decide)

/-- Evaluation semantics of the stated factorization. -/
theorem spectral_factorization_eval (x : Int) :
    peval (expandFac spectralFacCoeff spectralFacMonomial spectralFacFactors) x =
      spectralFacCoeff * x ^ spectralFacMonomial * facProd x spectralFacFactors :=
  peval_expandFac _ _ _ (by decide) x

/-- The discrepancy volume really is the first one: the series differ there. -/
theorem spectral_discrepancy : allCount spectralG spectralN spectralDiffVolume 2 ≠ allCount spectralCmpG spectralN spectralDiffVolume 2 := by
  rw [spectral_local _ (by decide), spectralCmp_local _ (by decide)]
  decide

/-! Rejection checks. -/

/-- `spectralG` with edge `(3, 6)` replaced by `(4, 6)`. -/
def spectralMutG : List (Nat × Nat) := [(0, 1), (0, 2), (0, 3), (0, 4), (1, 2), (3, 5), (4, 6)]

/-- Mutating one edge falsifies the decisive coefficient `[x^2 q^2] = 6`. -/
theorem spectral_edge_mutation_rejected : ¬ allCount spectralMutG spectralN 2 2 = 6 := by
  rw [allCount_eq_look_hist]; decide

/-- The checker rejects the released table for the mutated graph. -/
theorem spectral_edge_mutation_table : tableOK spectralMutG spectralN spectralTable = false := by decide

/-- A mutated decisive coefficient value is false for the certificate graph. -/
theorem spectral_coefficient_mutation_rejected : ¬ allCount spectralG spectralN 2 2 = 7 := by
  rw [spectral_local 2 (by decide)]; decide

/-- The checker rejects the table with that one coefficient mutated. -/
theorem spectral_mutated_table_rejected :
    tableOK spectralG spectralN (spectralTable.set 2 ((2, 7) :: (spectralTable.getD 2 []).drop 1)) = false := by
  decide

/-- A mutated first-difference polynomial and a mutated factorization are rejected. -/
theorem spectral_mutated_difference_rejected : diffOK (spectralTable.getD spectralDiffVolume [])
    (spectralCmpTable.getD spectralDiffVolume []) [(2, 2), (3, -4), (5, 4), (6, -3)] = false := by decide
theorem spectral_mutated_factorization_rejected : denseOK (spectralTable.getD spectralDiffVolume [])
    (spectralCmpTable.getD spectralDiffVolume []) (expandFac spectralFacCoeff spectralFacMonomial [(1, 3), (2, 1)]) = false := by
  decide

